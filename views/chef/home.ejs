<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <video autoplay loop muted playsinline id="bg-video">
        <source src="/video/minecraft_cherry_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/">ออกจากระบบ</a>
            <p>หน้าหลัก</p>
        </nav>

        <div class="middle">
            <div class="head">
                <div class="name">
                    <p>สวัสดี</p><p class="user_name"> <%= user_name %> </p>
                </div>
                <p class="remain">เวลาคงเหลือ</p>
                <p class="time">01 : 30 : 23</p>
            </div>
            <div class="card_div">
                <a href="/order" class="card">
                    <div class="card_box">
                        <img src="/image/steak.gif" alt="food" class="frame-icon" style="left: 48%; top: 50%; width: 70%; height: 70%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg" >
                        <div class="mc-tooltip">สั่งอาหาร</div>
                    </div>
                </a>

                <a href="/buy_time" class="card">
                    <div class="card_box">
                        <img src="/image/clock.gif" alt="plus_time" class="frame-icon" style="left: 52.2%; top: 52%; width: 65%; height: 63%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                        <div class="mc-tooltip">ซื้อเวลา</div>
                    </div>
                </a>

                <a href="/history" class="card">
                    <div class="card_box">
                        <img src="/image/EnchantedBook.gif" alt="paid_history" class="frame-icon" style="left: 52%; top: 52%; width: 65%; height: 65%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                        <div class="mc-tooltip">ดูประวัติการชำระเงิน</div>
                    </div>
                </a>
            </div>
        </div>
    </main>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
        });
    </script>
</body>
</html>