<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment</title>
    <link rel="stylesheet" href="/css/detail.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <video autoplay loop muted playsinline id="bg-video" preload="metadata">
        <source src="/video/minecraft_ocean_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/chef/orders">ย้อนกลับ</a>
            <p>รายละเอียดการสั่งซื้อ</p>
        </nav>
        <div class="main_div">
            <div class="package_card_wrapper">
                <div class="top">
                    <div class="inside">
                        <p class="title">สรุปรายการสั่งซื้อ</p>
                        <table>
                            <thead>
                                <tr>
                                    <th>สินค้า</th>
                                    <th>ราคา/ชิ้น</th>
                                    <th>ปริมาณ</th>
                                    <th>รวม</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% menu.forEach((item) => { %>
                                    <tr>
                                        <td> <%= item.name %> </td>
                                        <td> <%= item.unit_price %>.00 </td>
                                        <td> <%= item.quantity %> </td>
                                        <td> <%= item.subtotal %>.00 </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                        <div class="line"></div>
                        <div class="total">
                            <p class="title">ยอดรวม</p>
                            <p class="price"> <%= menu[0].total_amount %>.00 บาท</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="package_card_wrapper">
                <div class="bottom">
                    <div class="inside">
                        <p class="title">เลือกสถานะออเดอร์</p>
                        <div class="pay_method">
                            <form action="/adjust_order" method="POST">
                                <input type="hidden" name="order_id" value="<%= menu[0].order_id %>">
                                <div class="medthod_warpper">
                                    <label class="method">
                                        <input type="radio" name="chef_gived_status" value="เสร็จสิ้น" id="prompt-pay" checked>
                                        <div class="card_box">
                                            <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                                            <img src="/image/Diamond.png" alt="Diamond" class="frame-icon" style="left: 52.2%; top: 52%; width: 80%; height: 80%;">
                                        </div>
                                    </label>
                                    <p>เสร็จสิ้น</p>
                                </div>

                                <div class="medthod_warpper">
                                    <label class="method">
                                        <input type="radio" name="chef_gived_status" value="ยกเลิก" id="cash">
                                        <div class="card_box">
                                            <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                                            <img src="/image/Redstone.png" alt="Redstone" class="frame-icon" style="left: 52.2%; top: 51%; width: 76%; height: 76%;">
                                        </div>
                                    </label>
                                    <p>ยกเลิก</p>
                                </div>
                                <div class="btn">
                                    <button type="submit">ยืนยันสถานะออเดอร์ ํ</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
        });
    </script>
</body>
</html>