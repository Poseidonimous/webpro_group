<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buy More Time</title>
    <link rel="stylesheet" href="/css/buytime.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <video autoplay loop muted playsinline id="bg-video">
        <source src="/video/minecraft_lib_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/customer/home">หน้าหลัก</a>
            <p>ซื้อเวลา</p>
        </nav>

        <div class="head">
            <p class="remain">เวลาคงเหลือ</p>
            <p class="time">10 : 30 : 23</p>
        </div>

        <div class="tab">
            <form action="/purchase_time" method="post" class="payment-form">
                <div class="package_slot">

                    <div class="top">
                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="30" data-price="20" checked>
                                <img src="/image/Iron_Pickaxe.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">30 <small>นาที</small></div>
                                    <div class="price">20 บาท</div>
                                </div>
                            </label>
                        </div>

                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="60" data-price="40">
                                <img src="/image/Bucket_of_Axolotl.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">60 <small>นาที</small></div>
                                    <div class="price">40 บาท</div>
                                </div>
                            </label>
                        </div>

                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="90" data-price="55">
                                <img src="/image/Totem_of_Undying.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">90 <small>นาที</small></div>
                                    <div class="price">55 บาท</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="down">
                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="120" data-price="75">
                                <img src="/image/Netherite_Sword_noAlpha.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">120 <small>นาที</small></div>
                                    <div class="price">75 บาท</div>
                                </div>
                                
                            </label>
                        </div>
                        
                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="150" data-price="90">
                                <img src="/image/Enchanted_Bow.gif" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">150 <small>นาที</small></div>
                                    <div class="price">90 บาท</div>
                                </div>
                            </label>
                        </div>

                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="180" data-price="110">
                                <img src="/image/Enchanted_Trident.gif" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">180 <small>นาที</small></div>
                                    <div class="price">110 บาท</div>
                                </div>
                            </label>
                        </div>
                    </div>

                </div>
            </form>

            <div class="purchase">
                <a href="/customer/payment">
                <button>จ่ายเงิน ํ</button>
                </a>
            </div>
        </div>
    </main>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
        });
    </script>
</body>
</html>