<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buy More Time</title>
    <link rel="stylesheet" href="/css/buytime.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <video autoplay loop muted playsinline id="bg-video">
        <source src="/video/minecraft_lib_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/customer/home">หน้าหลัก</a>
            <p>ซื้อเวลา</p>
        </nav>

        <div class="head">
                <p class="remain">เวลาคงเหลือ</p>
                <p class="time" id="time-display">00 : 00 : 00</p>
            </div>

        <div class="tab">
            <form action="/buy_time" method="POST" class="payment-form">
                <div class="package_slot">

                    <div class="top">
                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="1" data-time="30" data-price="20" checked>
                                <img src="/image/Iron_Pickaxe.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">30 <small>นาที</small></div>
                                    <div class="price">20 บาท</div>
                                </div>
                            </label>
                        </div>

                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="2" data-time="60" data-price="40">
                                <img src="/image/Bucket_of_Axolotl.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">60 <small>นาที</small></div>
                                    <div class="price">40 บาท</div>
                                </div>
                            </label>
                        </div>

                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="3" data-time="90" data-price="55">
                                <img src="/image/Totem_of_Undying.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">90 <small>นาที</small></div>
                                    <div class="price">55 บาท</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="down">
                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="4" data-time="120" data-price="75">
                                <img src="/image/Netherite_Sword_noAlpha.png" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">120 <small>นาที</small></div>
                                    <div class="price">75 บาท</div>
                                </div>
                                
                            </label>
                        </div>
                        
                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="5" data-time="150" data-price="90">
                                <img src="/image/Enchanted_Bow.gif" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">150 <small>นาที</small></div>
                                    <div class="price">90 บาท</div>
                                </div>
                            </label>
                        </div>

                        <div class="package_card_wrapper">
                            <label class="package_card">
                                <input type="radio" name="package" value="6" data-time="180" data-price="110">
                                <img src="/image/Enchanted_Trident.gif" alt="item" class="frame-icon">
                                <div class="inform">
                                    <div class="minute">180 <small>นาที</small></div>
                                    <div class="price">110 บาท</div>
                                </div>
                            </label>
                        </div>
                    </div>

                </div>

                <div class="purchase">
                    <button type="submit">จ่ายเงิน ํ</button>
                </div>
            </form>

        </div>
    </main>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
        });

        const endTime = Number("<%= endTime %>") || 0;
        const timeDisplay = document.getElementById("time-display");

        function updateTimer() {
            const now = Date.now();
            const totalSeconds = Math.floor((endTime - now) / 1000);

            if (totalSeconds <= 0) {
                timeDisplay.innerText = "00 : 00 : 00";
                return;
            }

            let hours = Math.floor(totalSeconds / 3600);
            let minutes = Math.floor((totalSeconds % 3600) / 60);
            let seconds = totalSeconds % 60;

            let hStr = String(hours).padStart(2, '0');
            let mStr = String(minutes).padStart(2, '0');
            let sStr = String(seconds).padStart(2, '0');

            timeDisplay.innerText = `${hStr} : ${mStr} : ${sStr}`;
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    </script>
</body>
</html>