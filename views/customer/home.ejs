<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <video autoplay loop muted playsinline id="bg-video" preload="metadata">
        <source src="/video/minecraft_cherry_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/" onclick="sessionStorage.removeItem('homeAnimated')">ออกจากระบบ</a>
            <p>หน้าหลัก</p>
        </nav>

        <div class="middle">
            <div class="head">
                <div class="name">
                    <p>สวัสดี</p><p class="user_name"> <%= userName %> </p>
                </div>
                <p class="remain">เวลาคงเหลือ</p>
                <p class="time" id="time-display">00 : 00 : 00</p>
            </div>
            <div class="card_div">
                <a href="/customer/order" class="card">
                    <div class="card_box">
                        <img src="/image/steak.gif" alt="food" class="frame-icon" style="left: 48%; top: 50%; width: 70%; height: 70%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg" >
                        <div class="mc-tooltip">สั่งอาหาร</div>
                    </div>
                </a>

                <a href="/customer/buy_time" class="card">
                    <div class="card_box">
                        <img src="/image/clock.gif" alt="plus_time" class="frame-icon" style="left: 52.2%; top: 52%; width: 65%; height: 63%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                        <div class="mc-tooltip">ซื้อเวลา</div>
                    </div>
                </a>

                <a href="/customer/history" class="card">
                    <div class="card_box">
                        <img src="/image/EnchantedBook.gif" alt="paid_history" class="frame-icon" style="left: 52%; top: 52%; width: 65%; height: 65%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                        <div class="mc-tooltip">ดูประวัติการชำระเงิน</div>
                    </div>
                </a>
            </div>
        </div>
    </main>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
        });

        const endTime = Number("<%= endTime %>") || 0;
        const timeDisplay = document.getElementById("time-display");

        function updateTimer() {
            const now = Date.now();
            const totalSeconds = Math.floor((endTime - now) / 1000);

            if (totalSeconds <= 0) {
                timeDisplay.innerText = "00 : 00 : 00";
                
                // Alert เฉพาะตอนเปิดหน้า Home อยู่แล้วเวลานับจนหมด
                if (!window.timerEnded) {
                    window.timerEnded = true;
                    alert("เวลาใช้งานของคุณหมดแล้ว!");
                    window.location.href = "/customer/buy_time";
                }
                return;
            }

            let hours = Math.floor(totalSeconds / 3600);
            let minutes = Math.floor((totalSeconds % 3600) / 60);
            let seconds = totalSeconds % 60;

            let hStr = String(hours).padStart(2, '0');
            let mStr = String(minutes).padStart(2, '0');
            let sStr = String(seconds).padStart(2, '0');

            timeDisplay.innerText = `${hStr} : ${mStr} : ${sStr}`;
        }

        updateTimer();
        setInterval(updateTimer, 1000);

        document.addEventListener("DOMContentLoaded", () => {
            // เริ่มทำงานคอยเช็คสถานะออเดอร์ทุกๆ 5 วินาที
            setInterval(checkOrderStatus, 5000);
        });

        function checkOrderStatus() {
            fetch('/api/customer/my-orders')
                .then(response => {
                    if (!response.ok) throw new Error("Network response was not ok");
                    return response.json();
                })
                .then(orders => {
                    // อ่านรายการออเดอร์ที่เคยแจ้งเตือนไปแล้วจาก localStorage
                    let notifiedOrders = JSON.parse(localStorage.getItem('notified_canceled_orders') || '[]');

                    orders.forEach(order => {
                        // ถ้าออเดอร์ถูกเปลี่ยนเป็น "ยกเลิก" และยังไม่เคยแจ้งเตือนลูกค้ารายนี้มาก่อน
                        if (order.order_status === 'ยกเลิก' && !notifiedOrders.includes(order.order_id)) {
                            
                            // แสดงป๊อปอัปแจ้งเตือนลูกค้า
                            alert(`ออเดอร์หมายเลข ${order.order_id} ถูกยกเลิกโดยห้องครัว`);

                            // บันทึก order_id นี้เก็บไว้เพื่อไม่ให้แจ้งเตือนซ้ำอีกในรอบถัดไป
                            notifiedOrders.push(order.order_id);
                            localStorage.setItem('notified_canceled_orders', JSON.stringify(notifiedOrders));
                        }
                    });
                })
                .catch(err => {
                    console.error("Error checking order status:", err);
                });
        }

        document.addEventListener("DOMContentLoaded", () => {
            // เช็คว่าเคยแสดงอนิเมชันในรอบการใช้งานนี้หรือยัง
            if (!sessionStorage.getItem("homeAnimated")) {
                // หากยังไม่เคย ให้ใส่คลาส first-load เพื่อเล่นอนิเมชัน
                document.body.classList.add("first-load");
                // บันทึกค่าไว้ว่าเล่นอนิเมชันเรียบร้อยแล้ว
                sessionStorage.setItem("homeAnimated", "true");
            }
        });
    </script>
</body>
</html>