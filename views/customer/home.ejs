<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <video autoplay loop muted playsinline id="bg-video">
        <source src="/video/minecraft_cherry_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/">ออกจากระบบ</a>
            <p>หน้าหลัก</p>
        </nav>

        <div class="middle">
            <div class="head">
                <div class="name">
                    <p>สวัสดี</p><p class="user_name"> <%= userName %> </p>
                </div>
                <p class="remain">เวลาคงเหลือ</p>
                <p class="time" id="time-display">00 : 00 : 00</p>
            </div>
            <div class="card_div">
                <a href="/customer/order" class="card">
                    <div class="card_box">
                        <img src="/image/steak.gif" alt="food" class="frame-icon" style="left: 48%; top: 50%; width: 70%; height: 70%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg" >
                        <div class="mc-tooltip">สั่งอาหาร</div>
                    </div>
                </a>

                <a href="/customer/buy_time" class="card">
                    <div class="card_box">
                        <img src="/image/clock.gif" alt="plus_time" class="frame-icon" style="left: 52.2%; top: 52%; width: 65%; height: 63%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                        <div class="mc-tooltip">ซื้อเวลา</div>
                    </div>
                </a>

                <a href="/customer/history" class="card">
                    <div class="card_box">
                        <img src="/image/EnchantedBook.gif" alt="paid_history" class="frame-icon" style="left: 52%; top: 52%; width: 65%; height: 65%;">
                        <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                        <div class="mc-tooltip">ดูประวัติการชำระเงิน</div>
                    </div>
                </a>
            </div>
        </div>
    </main>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
        });

        const endTime = Number("<%= endTime %>") || 0;
        const timeDisplay = document.getElementById("time-display");

        function updateTimer() {
            const now = Date.now();
            const totalSeconds = Math.floor((endTime - now) / 1000);

            if (totalSeconds <= 0) {
                timeDisplay.innerText = "00 : 00 : 00";
                
                // Alert เฉพาะตอนเปิดหน้า Home อยู่แล้วเวลานับจนหมด
                if (!window.timerEnded) {
                    window.timerEnded = true;
                    alert("เวลาใช้งานของคุณหมดแล้ว!");
                    window.location.href = "/customer/buy_time";
                }
                return;
            }

            let hours = Math.floor(totalSeconds / 3600);
            let minutes = Math.floor((totalSeconds % 3600) / 60);
            let seconds = totalSeconds % 60;

            let hStr = String(hours).padStart(2, '0');
            let mStr = String(minutes).padStart(2, '0');
            let sStr = String(seconds).padStart(2, '0');

            timeDisplay.innerText = `${hStr} : ${mStr} : ${sStr}`;
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    </script>
</body>
</html>