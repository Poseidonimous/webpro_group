<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Drink & Food</title>
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <video autoplay loop muted playsinline id="bg-video">
        <source src="/video/minecraft_picnic_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/customer/home">หน้าหลัก</a>
            <p>สั่งอาหาร</p>
        </nav>
        <div class="outter_div">
            <div class="warpper">
                <div class="catelog_div">
                    <div class="title">
                        <p>หมวดหมู่</p>
                        <div class="line"></div>
                    </div>
                    <form action="/customer/order" method="get">

                        <div class="category">
                            <label>
                                <input type="radio" name="category" value="all" id="all" checked>
                                <p>ทั้งหมด</p>
                            </label>
                        </div>
                        
                        <div class="category">
                            <label>
                                <input type="radio" name="category" value="2" id="chips">
                                <p>ขนม</p>
                            </label>
                        </div>

                        <div class="category">
                            <label>
                                <input type="radio" name="category" value="3" id="drink">
                                <p>เครื่องดื่ม</p>
                            </label>
                        </div>

                        <div class="category">
                            <label>
                                <input type="radio" name="category" value="4" id="snack">
                                <p>ของทานเล่น</p>
                            </label>
                        </div>

                        <div class="category">
                            <label>
                                <input type="radio" name="category" value="5" id="meal">
                                <p>อาหาร</p>
                            </label>
                        </div>

                        <div class="category">
                            <label>
                                <input type="radio" name="category" value="6" id="desert">
                                <p>ของหวาน</p>
                            </label>
                        </div>

                    </form>
                </div>
            </div>
            
            <div class="big_warpper">
                <div class="menu_div">
                    <div class="menu">
                    </div>
                </div>
            </div>

            <div class="div_cart">
                <a href="/customer/cart">
                    <img src="/image/chest.png" 
                        data-static="/image/chest.png" 
                        data-gif="/image/chest.gif" 
                        alt="chest" 
                        class="chest_img">
                    <button>ตะกร้า (2)</button>
                </a>
            </div>
            
        </div>
    </main>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
        });

        const cartLink = document.querySelector('.div_cart a');
        const chestImg = document.querySelector('.chest_img');

        // 1. ระบุความยาวรวมของ GIF 1 รอบ (ปรับตัวเลขตรงนี้เป็นมิลลิวินาทีตามไฟล์จริงของคุณ)
        // เช่น ถ้า GIF ยาว 1.2 วินาที ให้ใส่ 1200
        const GIF_DURATION = 4100; 

        let startTime = 0;
        let delayTimer;

        // ตอนเอาเมาส์ชี้ (Hover)
        cartLink.addEventListener('mouseenter', () => {
            clearTimeout(delayTimer); // เคลียร์ตัวจับเวลาเดิม
            startTime = Date.now();   // บันทึกเวลาที่เริ่มเอาเมาส์ชี้
            chestImg.src = chestImg.dataset.gif;
        });

        // ตอนเอาเมาส์ออก (Unhover)
        cartLink.addEventListener('mouseleave', () => {
            const elapsedTime = Date.now() - startTime;          // เวลาทั้งหมดที่เล่นไป
            const currentLoopTime = elapsedTime % GIF_DURATION;  // ตำแหน่งเวลาในรอบปัจจุบัน
            const remainingTime = GIF_DURATION - currentLoopTime; // เวลาที่เหลือกว่าจะจบครบรอบนี้

            // สั่งให้รอจนจบครบรอบนั้นพอดี แล้วค่อยเปลี่ยนกลับเป็น PNG
            delayTimer = setTimeout(() => {
                chestImg.src = chestImg.dataset.static;
            }, remainingTime);
        });

        const categoryRadios = document.querySelectorAll('input[name="category"]');
        const menuContainer = document.querySelector('.menu');

        // 1. สร้างฟังก์ชันสำหรับดึงข้อมูลและแสดงผล
        function loadProducts(category) {
            fetch(`/api/products?category=${category}`)
                .then(res => res.json())
                .then(products => {
                    // ล้างข้อมูลเก่าออก
                    menuContainer.innerHTML = ''; 
                    
                    // เช็คว่ามีสินค้าไหม
                    if(products.length === 0) {
                        menuContainer.innerHTML = '<p style="text-align:center; padding: 20px;">ไม่มีรายการสินค้า</p>';
                        return;
                    }

                    // วาด HTML ของสินค้าแต่ละชิ้น (คุณสามารถปรับแก้ HTML ตรงนี้ให้ตรงกับดีไซน์กล่องอาหารของคุณได้เลย)
                    products.forEach(p => {
                        menuContainer.innerHTML += `
                            <div class= "shadow">
                                <div class="item">
                                    <img src="/${p.image_url}" alt="${p.name}">
                                    <div class= "detail">
                                        <p class= "product_name">${p.name}</p>
                                        <p class= "product_price">ราคา: ${p.price} ฿</p>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                })
                .catch(err => console.error("Error loading products:", err));
        }

        // 2. ดักจับตอนผู้ใช้คลิกเปลี่ยนหมวดหมู่
        categoryRadios.forEach(radio => {
            radio.addEventListener('change', (e) => {
                loadProducts(e.target.value); // เรียกใช้ฟังก์ชันดึงข้อมูลตาม value ที่กด
            });
        });

        // 3. ⭐️ สำคัญที่สุด: สั่งให้โหลดข้อมูลหมวด 'all' ทันทีที่เปิดหน้าเว็บ!
        window.addEventListener('DOMContentLoaded', () => {
            loadProducts('all'); 
        });
    </script>
</body>
</html>