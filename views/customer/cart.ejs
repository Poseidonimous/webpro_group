<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment</title>
    <link rel="stylesheet" href="/css/cart.css">
    <link rel="icon" type="image/png" href="/image/icon.png">
</head>
<body>
    <!-- vid -->
    <video autoplay loop muted playsinline id="bg-video" preload="metadata">
        <source src="/video/minecraft_ocean_cp.mp4" type="video/mp4">
    </video>
    <main>
        <nav>
            <a href="/customer/order">ย้อนกลับ</a>
            <p>รถเข็น</p>
        </nav>
        <div class="main_div">
            <div class="package_card_wrapper">
                <div class="top">
                    <div class="inside">
                        <p class="title">สรุปรายการสั่งซื้อ</p>
                        <table>
                            <thead>
                                <tr>
                                    <th>สินค้า</th>
                                    <th>ราคา/ชิ้น</th>
                                    <th>ปริมาณ</th>
                                    <th>รวม</th>
                                </tr>
                            </thead>
                            <!-- ใช้ ID cart-tbody สำหรับใช้วาดข้อมูลจาก JavaScript -->
                            <tbody id="cart-tbody">
                                <tr>
                                    <td colspan="4" style="text-align:center; padding: 20px;">กำลังโหลดรายการสินค้า...</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="line"></div>
                        <div class="total">
                            <p class="title">ยอดรวม</p>
                            <!-- แสดงยอดรวมทั้งหมด -->
                            <p class="price" id="grand-total">0.00 บาท</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="package_card_wrapper">
                <div class="bottom">
                    <div class="inside">
                        <p class="title">เลือกช่องทางการจ่ายเงิน</p>
                        <div class="pay_method">
                            <!-- ฟอร์มจะส่งแค่ payment_method ส่วนสินค้าจะถูกส่งไปพร้อมกับ Cookie อัตโนมัติ -->
                            <form action="/cart_payment" method="post">
                                <div class="medthod_warpper">
                                    <label class="method">
                                        <input type="radio" name="payment_method" value="พร้อมเพย์" id="prompt-pay" checked>
                                        <div class="card_box">
                                            <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                                            <img src="/image/Diamond.png" alt="Diamond" class="frame-icon" style="left: 52.2%; top: 52%; width: 80%; height: 80%;">
                                        </div>
                                    </label>
                                    <p>พร้อมเพย์</p>
                                </div>

                                <div class="medthod_warpper">
                                    <label class="method">
                                        <input type="radio" name="payment_method" value="เงินสด" id="cash">
                                        <div class="card_box">
                                            <img src="/image/itemslot_1_1.png" alt="item_slot" class="frame-bg">
                                            <img src="/image/Emerald.webp" alt="Emerald" class="frame-icon" style="left: 52.2%; top: 52%; width: 75%; height: 75%;">
                                        </div>
                                    </label>
                                    <p>เงินสด</p>
                                </div>
                                <div class="btn">
                                    <button type="submit">ยืนยันการจ่ายเงิน</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        let allProducts = []; // สำหรับเก็บข้อมูลสินค้าจาก API

        // ==========================================
        // ส่วนจัดการ Cookie
        // ==========================================
        function getCartCookie() {
            const name = "cart=";
            const decodedCookie = decodeURIComponent(document.cookie);
            const ca = decodedCookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i].trim();
                if (c.indexOf(name) === 0) {
                    try {
                        return JSON.parse(c.substring(name.length, c.length));
                    } catch (e) {
                        return [];
                    }
                }
            }
            return [];
        }

        function setCartCookie(cartData) {
            const jsonString = encodeURIComponent(JSON.stringify(cartData));
            document.cookie = `cart=${jsonString}; path=/; max-age=86400`;
        }
        // ==========================================

        // เล่นวิดีโอพื้นหลังอัตโนมัติ
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.getElementById("bg-video");
            if (video) {
                video.play().catch(error => {
                    console.log("Autoplay was prevented, retrying...", error);
                });
            }
            // โหลดข้อมูลตะกร้าสินค้าตอนเปิดหน้าเว็บ
            loadCart();
        });

        // ฟังก์ชันอ่านข้อมูลตะกร้า (เปลี่ยนมาอ่านจาก Cookie)
        function getCart() {
            return getCartCookie();
        }

        // ฟังก์ชันบันทึกข้อมูลตะกร้า (เปลี่ยนมาเซฟลง Cookie)
        function saveCart(cart) {
            setCartCookie(cart);
        }

        // ฟังก์ชันดึงข้อมูลสินค้าทั้งหมดเพื่อหาชื่อและราคามาแมตช์กับ ID ในตะกร้า
        function loadCart() {
            fetch('/api/products?category=all')
                .then(res => {
                    if (!res.ok) throw new Error("ไม่สามารถโหลดข้อมูลสินค้าได้");
                    return res.json();
                })
                .then(products => {
                    allProducts = products;
                    renderCartTable();
                })
                .catch(err => {
                    console.error("Error fetching products:", err);
                    const tbody = document.getElementById('cart-tbody');
                    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:red; padding: 20px;">เกิดข้อผิดพลาดในการโหลดข้อมูล</td></tr>';
                });
        }

        // ฟังก์ชันวาดตารางสินค้าและคำนวณราคารวม
        function renderCartTable() {
            const cart = getCart();
            const tbody = document.getElementById('cart-tbody');
            const grandTotalEl = document.getElementById('grand-total');

            tbody.innerHTML = '';
            let grandTotal = 0;

            // ถ้าไม่มีสินค้าในตะกร้า
            if (!cart || cart.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 20px;">ไม่มีสินค้าในรถเข็น</td></tr>';
                grandTotalEl.textContent = '0.00 บาท';
                return;
            }

            // วนลูปสินค้าแต่ละรายการในตะกร้า
            cart.forEach(item => {
                // ค้นหาสินค้าจาก ID ที่ตรงกัน
                const p = allProducts.find(prod => (prod.id || prod.product_id) == item.product_id);
                if (!p) return; // หากไม่พบสินค้า

                const unitPrice = Number(p.price) || 0;
                const itemTotal = unitPrice * item.quantity;
                grandTotal += itemTotal;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${p.name || p.product_name}</td>
                    <td>${unitPrice.toFixed(2)}</td>
                    <td>
                        <div class="qty-control">
                            <div class="qty-btn_wrapper">
                                <button type="button" class="qty-btn" onclick="changeQty(${item.product_id}, -1)">-</button>
                            </div>
                            <span class="qty-val">${item.quantity}</span>
                            <div class="qty-btn_wrapper">
                                <button type="button" class="qty-btn" onclick="changeQty(${item.product_id}, 1)">+</button>
                            </div>
                        </div>
                    </td>
                    <td>${itemTotal.toFixed(2)}</td>
                `;
                tbody.appendChild(tr);
            });

            // อัปเดตยอดรวมทั้งหมด (.toFixed(2) เพื่อให้เป็นทศนิยม 2 ตำแหน่งเสมอ)
            grandTotalEl.textContent = `${grandTotal.toFixed(2)} บาท`;
        }

        // ฟังก์ชันเพิ่ม-ลดจำนวนสินค้า
        function changeQty(productId, delta) {
            let cart = getCart();
            const itemIndex = cart.findIndex(item => item.product_id == productId);

            if (itemIndex !== -1) {
                cart[itemIndex].quantity += delta;

                // ถ้าน้อยกว่าหรือเท่ากับ 0 ให้ลบสินค้านั้นออกจากตะกร้า
                if (cart[itemIndex].quantity <= 0) {
                    cart.splice(itemIndex, 1);
                }

                saveCart(cart);
                renderCartTable(); // วาดตารางและคำนวณราคารวมใหม่ทันที
            }
        }
    </script>
</body>
</html>